{
  "name": "@anil-labs/json-viewer-solid",
  "version": "0.1.0",
  "description": "SolidJS bindings for @anil-labs/json-viewer-core — a framework-agnostic JSON tree viewer with expand/collapse, syntax highlighting, dark/light themes and copy-to-clipboard.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"covered by @anil-labs/json-viewer-core\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "solid",
    "solidjs",
    "json-viewer",
    "json-tree",
    "tree-view"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Er. Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/json-viewer.git",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/anilkumarthakur60/json-viewer/tree/main/packages/solid#readme",
  "bugs": "https://github.com/anilkumarthakur60/json-viewer/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anil-labs/json-viewer-core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  }
}
