{
  "name": "@anil-labs/json-viewer-vue",
  "version": "0.1.0",
  "description": "Vue 3 bindings for @anil-labs/json-viewer-core  a collapsible JSON tree viewer with syntax highlighting, type badges, dark/light themes and copy-to-clipboard.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"covered by @anil-labs/json-viewer-core\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vue",
    "vue3",
    "json-viewer",
    "json-tree",
    "tree-view"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Er. Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/json-viewer.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/anilkumarthakur60/json-viewer/tree/main/packages/vue#readme",
  "bugs": "https://github.com/anilkumarthakur60/json-viewer/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anil-labs/json-viewer-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vue": "^3.5.39"
  }
}
