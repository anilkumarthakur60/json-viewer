{
  "name": "@anil-labs/json-viewer-core",
  "version": "0.1.0",
  "description": "Framework-agnostic JSON tree viewer — expand/collapse with persistent state, syntax highlighting, rainbow brackets, type badges, dark/light themes and copy-to-clipboard. Renders its own DOM. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "json",
    "json-viewer",
    "json-tree",
    "tree-view",
    "syntax-highlighting",
    "collapsible",
    "framework-agnostic",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Er. Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/json-viewer.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/anilkumarthakur60/json-viewer/tree/main/packages/core#readme",
  "bugs": "https://github.com/anilkumarthakur60/json-viewer/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^15.11.6",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
